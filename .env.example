# Copy this file to .env and fill in real values. .env is git-ignored.
# On Netlify, add the same names under Site configuration → Environment variables.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
N8N_WEBHOOK_URL=
# Shared secret FundScout sends to n8n in the X-FundScout-Secret header (same value in n8n's Header Auth credential)
N8N_WEBHOOK_SECRET=
# Secret FundScout uses to sign the per-scan token n8n needs to write to the activity log
AUTOMATION_LOG_SECRET=
