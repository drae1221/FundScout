{
  "name": "fundscout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p netlify && vite build",
    "preview": "vite preview",
    "scan": "esbuild scripts/run-scan.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/run-scan.mjs --log-level=warning && node --env-file=.env node_modules/.cache/run-scan.mjs",
    "draft": "esbuild scripts/run-draft.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/run-draft.mjs --log-level=warning && node --env-file=.env node_modules/.cache/run-draft.mjs",
    "save-demo": "esbuild scripts/save-demo.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/save-demo.mjs --log-level=warning && node --env-file=.env node_modules/.cache/save-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
